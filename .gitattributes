*.sh text eol=lf

# These are authored on Windows and consumed only inside Linux containers. nginx tolerates a
# CRLF config and Docker tolerates a CRLF Dockerfile, so the failure this prevents is the
# later one: the first RUN line holding a shell script, which fails with `not found` about a
# file that plainly exists.
Dockerfile text eol=lf
*.conf text eol=lf

# Compose parses .env itself rather than handing it to a shell, and a CRLF line ending becomes a
# carriage return on the end of every value. The generated .env is never in git, but the example is
# the file people copy from, so it checks out with the endings its consumer expects.
.env.example text eol=lf
