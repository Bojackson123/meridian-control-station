# Meridian Control Station -- the stack's entire configuration surface.
#
# This file is committed and contains no secrets. The real file is `.env` in this directory,
# it is git-ignored, and it is produced by:
#
#     ./tools/bootstrap-env.sh      (POSIX shells)
#     ./tools/bootstrap-env.ps1     (PowerShell 5.1 or 7+)
#
# Run the script rather than copying this file: POSTGRES_PASSWORD below is a placeholder, and a
# stack standing up with a placeholder for a credential is the failure this arrangement exists to
# prevent. Nothing in the repo should ever contain a password that works.
#
# This file lives at the repo root, and Compose looks for `.env` beside the compose file, so the
# stack is always started by pointing at it -- from the repo root:
#
#     docker compose --env-file .env -f deploy/compose/compose.yaml up --build
#
# Without the flag every ${...} in the compose file substitutes to an empty string. It fails loudly
# rather than quietly, because compose.yaml guards each variable with the `:?` form.
#
# Every variable here is consumed by deploy/compose/compose.yaml; the API itself receives
# ConnectionStrings__Mcs, which Compose builds from the three POSTGRES_* values -- the connection
# string is assembled, never stored.

# Postgres role the station connects as. Fixed; not generated.
POSTGRES_USER=mcs

# GENERATED by the bootstrap script: 64 hex characters from the platform CSPRNG.
#
# Postgres fixes this password when it first initialises its data directory and ignores the variable
# on every start afterwards. Changing it here later does not change the database -- you also have to
# drop the pgdata volume, or the next start fails authentication against a volume nothing can open.
POSTGRES_PASSWORD=replace-me-by-running-tools/bootstrap-env

# Database the station's schema is applied to. Fixed; not generated.
POSTGRES_DB=mcs

# Host port for the API. Published mainly so the smoke suite and `curl` can reach /health and
# /health/db directly; the browser goes through the web container's /api proxy instead.
MCS_API_PORT=8081

# Host port for the web UI. This is the one you open. Change either port if something on the host
# already holds it -- Compose is the only consumer, so nothing else needs to agree.
MCS_WEB_PORT=8080

# Reserved, not yet used: MCS_JWT_SIGNING_KEY will be generated here the same way once commands
# require an authenticated operator. The mechanism is deliberately in place before the key that
# makes it matter -- retrofitting secret handling around a credential that has already spent weeks
# in a committed file is not a thing you can do afterwards.
