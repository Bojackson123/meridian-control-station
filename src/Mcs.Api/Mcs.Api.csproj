<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mcs.Core\Mcs.Core.csproj" />
    <ProjectReference Include="..\Mcs.Adapters\Mcs.Adapters.csproj" />
  </ItemGroup>

  <!--
    Migrations are compiled into the assembly rather than copied beside it. A migration belongs to
    the build that ships it, so it should not be separately deletable, mountable over, or missing
    from an image because a COPY line was forgotten, and the symptom of any of those is an API
    that starts happily against a database it has not migrated. The glob means a new .sql file is
    picked up by adding it, with no second place to remember.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\deploy\migrations\*.sql" LinkBase="Migrations" />
  </ItemGroup>

  <!-- Migration loading is an implementation detail with rules worth testing directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Mcs.Api.Tests" />
    <InternalsVisibleTo Include="Mcs.Integration.Tests" />
  </ItemGroup>

</Project>
