{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Npgsql": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "StartupTimeoutSeconds": 30
  },
  "Adapters": {
    "Mavlink": {
      "ListenAddress": "0.0.0.0",
      "Port": 14550
    }
  }
}
